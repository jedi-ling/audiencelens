# AudienceLens — every environment variable the code reads, names only (no values).
# Platform: copy to web/.env (web/backend/app/config.py loads it); Docker reads the same
# file through web/docker-compose.yml. Core CLI: export the engine variables in your shell.
# Defaults and full explanations: docs/MAINTENANCE.md §2. Production template with
# suggested values: web/.env.production.example.

# ---- Core engine (src/) ----
# Anthropic API key used by the CLI engine and as the platform-paid key in managed/hybrid mode
ANTHROPIC_API_KEY=
# Max persona calls the engine runs in parallel
AUDIENCELENS_MAX_CONCURRENCY=

# ---- Runtime / deployment ----
# "production" turns on production startup checks; "development" for local work
AL_ENV=
# Verbose error output; keep off in production
AL_DEBUG=
# SQLAlchemy URL; empty = SQLite under web/backend/data/
AL_DATABASE_URL=
# Comma-separated browser origins allowed by CORS (your site URL)
AL_CORS_ORIGINS=
# Public URL of the web app, used in e-mail links and the QQ login redirect
AL_PUBLIC_WEB_URL=
# Tests only: skip loading web/.env
AL_SKIP_DOTENV=

# ---- Accounts and sessions ----
# true = multi-tenant (register/login + per-visitor guest identities); false = single-user local mode
AL_AUTH_ENABLED=
# Secret that signs session tokens (generate with: openssl rand -hex 32)
AL_JWT_SECRET=
# Lifetime of a login session token, in seconds
AL_JWT_TTL_SECONDS=
# Master key that encrypts stored user API keys; never reuse the JWT secret
AL_ENCRYPTION_KEY=
# Lifetime of e-mail verification links, in seconds
AL_EMAIL_TOKEN_TTL_SECONDS=
# Lifetime of password-reset links, in seconds
AL_RESET_TOKEN_TTL_SECONDS=
# Name of the HttpOnly cookie that carries an unauthenticated visitor's guest identity
AL_GUEST_COOKIE_NAME=
# Secure flag on the guest cookie; only turn off for plain-http local debugging
AL_GUEST_COOKIE_SECURE=
# Lifetime of the guest cookie / guest token, in seconds
AL_GUEST_COOKIE_TTL_SECONDS=
# Max new guest identities per source IP per hour (over the limit returns 429)
AL_GUEST_IDENTITY_PER_HOUR=
# Escape hatch: allow AL_AUTH_ENABLED=false on a production-like host (all visitors share one identity)
AL_ALLOW_SHARED_ANONYMOUS=

# ---- QQ login (optional; all three must be set) ----
# QQ Connect app id
AL_QQ_APP_ID=
# QQ Connect app key
AL_QQ_APP_KEY=
# QQ Connect callback URL registered for the app
AL_QQ_REDIRECT_URI=

# ---- E-mail (verification / password reset) ----
# "smtp" to really send mail; "console" writes mail to the outbox directory instead
AL_MAIL_BACKEND=
# From address, e.g. "AudienceLens <noreply@your-domain>"
AL_MAIL_FROM=
# Directory the console backend writes mails to
AL_MAIL_OUTBOX_DIR=
# SMTP server host
AL_SMTP_HOST=
# SMTP server port
AL_SMTP_PORT=
# SMTP user name
AL_SMTP_USER=
# SMTP password or app-specific token
AL_SMTP_PASSWORD=
# true = implicit SSL (usually port 465); false = STARTTLS
AL_SMTP_USE_SSL=
# SMTP connect/send timeout, in seconds
AL_SMTP_TIMEOUT_SECONDS=
# Escape hatch: allow the console mail backend in production with accounts enabled
AL_ALLOW_CONSOLE_MAIL=

# ---- LLM key policy ----
# "byok" (users bring keys), "managed" (platform key only) or "hybrid" (user key, else platform key)
AL_KEY_MODE=
# Enable the LLM-based intent parser for the conversational entry point
AL_INTENT_LLM_ENABLED=
# Model used by the intent parser
AL_INTENT_MODEL=

# ---- Quotas and pricing (platform-paid reviews) ----
# Turn quota enforcement on or off
AL_QUOTA_ENABLED=
# "plan" (daily limits per plan) or "credits" (CDK credit balance)
AL_QUOTA_MODE=
# Free plan: reviews per day on the platform key
AL_QUOTA_FREE_REVIEWS_PER_DAY=
# Free plan: platform cost cap per day, in USD
AL_QUOTA_FREE_COST_USD_PER_DAY=
# Daily review limit for accounts whose e-mail is not verified yet
AL_QUOTA_UNVERIFIED_REVIEWS_PER_DAY=
# Lifetime platform-token cap per account (0 = unlimited)
AL_QUOTA_TOKENS_TOTAL=
# Token estimate reserved per review before the real usage is known
AL_QUOTA_TOKENS_PER_REVIEW_ESTIMATE=
# Pro plan: default platform cost cap per day, in USD (≈ monthly price / 30; admin panel can override)
AL_PLAN_PRO_COST_USD_PER_DAY=
# Team plan: default platform cost cap per day, in USD (≈ monthly price / 30; admin panel can override)
AL_PLAN_TEAM_COST_USD_PER_DAY=
# Comma-separated skill types treated as premium
AL_PREMIUM_SKILLS=
# Free uses of premium skills per account
AL_SKILL_FREE_USES=

# ---- Rate limiting ----
# Master switch for all rate limits
AL_RATELIMIT_ENABLED=
# General API requests per minute per client
AL_RATELIMIT_PER_MINUTE=
# Review submissions per hour per client
AL_RATELIMIT_REVIEW_PER_HOUR=

# ---- Queue ----
# Review queue backend: "inprocess" (default; backend must run as a single process) or "external"
AL_QUEUE_BACKEND=
# Number of review worker threads
AL_QUEUE_WORKERS=

# ---- Uploads ----
# Directory for uploaded files
AL_UPLOAD_DIR=
# Max size of a document upload, in bytes
AL_UPLOAD_MAX_BYTES=
# Max size of an image upload, in bytes
AL_UPLOAD_MAX_IMAGE_BYTES=
# Comma-separated document extensions accepted for upload
AL_UPLOAD_ALLOWED_EXT=
# Comma-separated image extensions accepted for upload
AL_UPLOAD_ALLOWED_IMAGE_EXT=

# ---- Features ----
# Enable the judgment ledger (predictions + later verification)
AL_LEDGER_ENABLED=

# ---- Admin panel ----
# Static admin token for /api/admin/* (unset = admin API disabled)
AL_ADMIN_TOKEN=

# ---- Docker Compose / reverse proxy ----
# Domain Caddy requests the HTTPS certificate for
SITE_DOMAIN=
# Host:port the frontend container binds to (e.g. 127.0.0.1:8080 behind Caddy)
FRONTEND_BIND=
# Frontend bind override used by docker-compose.prod.yml
PROD_FRONTEND_BIND=
# Build the backend image with the optional semantic de-duplication model
INSTALL_SEMANTIC_DEDUP=

# ---- Frontend build time (Vite; rebuild the frontend after changing) ----
# API origin when the frontend is served from a different origin (empty = same origin)
VITE_API_BASE=
# UI languages to ship, e.g. "zh,en"
VITE_AL_LOCALES=
# This instance's own ICP filing number; empty = no filing line in footer / terms
VITE_ICP_TEXT=
# Development only: use built-in mock data instead of the backend
VITE_USE_MOCK=
