# 生产环境配置模板 —— 复制为 web/.env 后逐项填写（docker compose 会自动读取同目录 .env）
#   cp .env.production.example .env
# 带 [必改] 的项不改就上线 = 裸奔；backend 在 AL_ENV=production 下会对默认 JWT 密钥拒绝启动。

# ---- 基础 ----
AL_ENV=production
# [必改] 正式域名（逗号分隔，同时用于 CORS 和 WS origin 白名单）
AL_CORS_ORIGINS=https://你的域名.com,https://www.你的域名.com

# ---- 密钥（都用 openssl rand -hex 32 生成，两个必须不同）----
# [必改] JWT 签名密钥——轮换它会踢掉所有登录态
AL_JWT_SECRET=
# [必改] BYOK/平台 key 落库加密密钥——设置后绝不轻易轮换（轮换 = 所有已存 key 解密失败需重填）
AL_ENCRYPTION_KEY=
# [必改] 后台管理面板令牌（不设置则 /api/admin/* 全部 503）
AL_ADMIN_TOKEN=

# ---- 产品形态：混合模式（有 key 用用户的，没 key 走平台垫付 + CDK 次数）----
AL_AUTH_ENABLED=true
AL_KEY_MODE=hybrid
AL_QUOTA_ENABLED=true
# credits = CDK 纯次数制（一个码 N 次用完即止）；plan = 套餐日限额
AL_QUOTA_MODE=credits
# 平台垫付用的 key（也可上线后在后台管理面板里配，支持非 Anthropic 服务商）
ANTHROPIC_API_KEY=

# ---- 邮件（[必改]，AL_AUTH_ENABLED=true 时不配就起不来）----
# 不配这一段 = 用户注册后收不到激活邮件、忘记密码找不回，而且后端不会报任何错。
# 后端启动自检会拦：类生产环境 + 开了账号体系 + 邮件后端不是 smtp → 拒绝启动。
# 填完请到后台「运行时配置 → 邮件发送」点一次「发送测试邮件」当场验证。
AL_MAIL_BACKEND=smtp
# [必改] SMTP 服务器地址。填服务商给的那个主机名，**不是**你的网站域名。
AL_SMTP_HOST=
# 端口与加密方式必须成对：465 配 AL_SMTP_USE_SSL=true；587 / 25 配 false（STARTTLS）。
# 国内云厂商默认封禁 25 端口出方向，优先用 465 或 587。
AL_SMTP_PORT=465
AL_SMTP_USE_SSL=true
# [必改] 登录 SMTP 的账号，通常就是你的发信邮箱地址
AL_SMTP_USER=
# [必改] 多数服务商这里要填「授权码 / 应用专用密码」（在邮箱网页端单独申请），
#        **不是**网页登录密码。
AL_SMTP_PASSWORD=
# [必改] 发件人。地址部分要与 AL_SMTP_USER 一致，或属于已在服务商处验证的域名，
#        否则会被 SMTPSenderRefused 拒掉。留默认的 @localhost 必被拒。
AL_MAIL_FROM=AudienceLens <noreply@你的域名.com>
# [必改] 验证 / 重置链接的落点，即用户实际打开的站点地址。
#        配错这里邮件能发出，但用户点开链接是打不开的页面。
AL_PUBLIC_WEB_URL=https://你的域名.com
# 单次 SMTP 操作超时固定 15 秒（AL_SMTP_TIMEOUT_SECONDS，但 docker-compose.yml
# 没有透传这一项，所以在 Docker 部署下写在这里是不生效的——故意不列成配置项）。
#
# 暂时不想接邮件服务商？必须显式声明，否则拒绝启动：
#   AL_ALLOW_CONSOLE_MAIL=true
# 代价说清楚：邮箱验证与密码重置**完全不可用**；含令牌的完整邮件会写到
# 容器内 /app/data/outbox/（0600 文件），能读它的人即可接管任意账号。

# ---- 可选调优（默认值一般够用）----
# AL_RATELIMIT_PER_MINUTE=60
# AL_RATELIMIT_REVIEW_PER_HOUR=20
# AL_QUEUE_WORKERS=2
# AUDIENCELENS_MAX_CONCURRENCY=6
# AL_INTENT_MODEL=claude-haiku-4-5-20251001
# 换 Postgres 时用（默认 SQLite 单机够用）：
# AL_DATABASE_URL=postgresql://user:pass@host:5432/audiencelens
