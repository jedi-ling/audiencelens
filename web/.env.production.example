# 生产环境配置模板 —— 复制为 web/.env 后逐项填写（docker compose 会自动读取同目录 .env）
#   cp .env.production.example .env
# 带 [必改] 的项不改就上线 = 裸奔；backend 在 AL_ENV=production 下会对默认 JWT 密钥拒绝启动。

# ---- 基础 ----
AL_ENV=production
# [必改] 正式域名（逗号分隔，同时用于 CORS 和 WS origin 白名单）
AL_CORS_ORIGINS=https://你的域名.com,https://www.你的域名.com

# 前端可切换的界面语言。这条是**构建期**变量（docker-compose.yml 的
# frontend.build.args），不是运行时开关——改完这一行必须 `--build`
# 重新构建镜像才生效，跟下面那些 backend 运行时读的 AL_* 完全是两回事。
# 只写 zh：语言切换器不出现，全站纯中文。默认 zh,en：中英双语已过全站验证。
VITE_AL_LOCALES=zh,en

# ---- 密钥（都用 openssl rand -hex 32 生成，两个必须不同）----
# [必改] JWT 签名密钥——轮换它会踢掉所有登录态
AL_JWT_SECRET=
# [必改] BYOK/平台 key 落库加密密钥——设置后绝不轻易轮换（轮换 = 所有已存 key 解密失败需重填）
AL_ENCRYPTION_KEY=
# [必改] 后台管理面板令牌（不设置则 /api/admin/* 全部 503）
AL_ADMIN_TOKEN=

# ---- 产品形态：混合模式（有 key 用用户的，没 key 走平台垫付 + CDK 次数）----
AL_AUTH_ENABLED=true
AL_KEY_MODE=hybrid
AL_QUOTA_ENABLED=true
# credits = CDK 纯次数制（一个码 N 次用完即止）；plan = 套餐日限额
AL_QUOTA_MODE=credits
# 每个账号**累计**能烧掉的平台 token（输入+输出），0 = 不限。体验用户的终身额度。
# 与上面两种配额的区别：次数闸和成本闸都是 24h 滚动窗口，跨天重置，拦得住"一天刷爆"
# 拦不住"每天用满连用一个月"；这一条不重置。只算平台垫付，BYOK 不受影响。
# 注意它保证的是"下一次还能不能开始"，不是"这一次不会超"——token 用量要等评审跑完
# 才知道，人格又是并发发出去的。真正的硬约束仍然是你发出去多少 CDK 次数。
AL_QUOTA_TOKENS_TOTAL=3000000
# 发起评审时按这个数给终身额度占位，跑完用真实用量顶掉。它决定并发超额的上界：
# 没有占位时并发请求会各自读到"没超"而全部放行（实测 8 线程 8/8 全过）。
# 设 0 = 关闭占位（闸门仍生效，退回逐次检查）。按你的实际单次用量调。
AL_QUOTA_TOKENS_PER_REVIEW_ESTIMATE=150000

# ---- 高级技能的免费体验次数 ----
# 每个账号能免费用几次高级技能（走平台垫付时）。用完不报错，静默降级成普通评审
# 并如实告知——新用户还没建立价值感就撞墙，转化反而更差。
# 0 = 对免费用户完全关闭；负数 = 不限制。BYOK 用户始终不受此限制。
AL_SKILL_FREE_USES=3
# 哪些技能算"高级"（逗号分隔，取值见 models.SkillType）。默认只有红队：
# 它是唯一真正多花钱的那层（人格评审之后额外跑一轮对抗质询）；
# 受众面板是本产品的核心价值，设成收费等于把产品本身关掉。
AL_PREMIUM_SKILLS=red_team_audience

# ---- 未验证邮箱的软拦 / 限流 / 意图解析（都有安全或成本含义，别关）----
# 未验证邮箱的账号每天只能用平台 key 评审几次。软拦：能登录能用，只是额度低，
# 验证邮箱即解锁完整额度。设负数关闭本机制。
AL_QUOTA_UNVERIFIED_REVIEWS_PER_DAY=1
# 限流总开关。关掉 = 注册/登录/评审/上传全部不限速，任何人都能刷爆你的平台 key。
AL_RATELIMIT_ENABLED=true
# 用 LLM 解析用户的自然语言意图（关掉则退回关键词规则档，识别率明显下降）。
AL_INTENT_LLM_ENABLED=true
# 平台垫付用的 key（也可上线后在后台管理面板里配，支持非 Anthropic 服务商）
ANTHROPIC_API_KEY=

# ---- 邮件（[必改]，AL_AUTH_ENABLED=true 时不配就起不来）----
# 不配这一段 = 用户注册后收不到激活邮件、忘记密码找不回，而且后端不会报任何错。
# 后端启动自检会拦：类生产环境 + 开了账号体系 + 邮件后端不是 smtp → 拒绝启动。
# 填完请到后台「运行时配置 → 邮件发送」点一次「发送测试邮件」当场验证。
AL_MAIL_BACKEND=smtp
# [必改] SMTP 服务器地址。填服务商给的那个主机名，**不是**你的网站域名。
AL_SMTP_HOST=
# 端口与加密方式必须成对：465 配 AL_SMTP_USE_SSL=true；587 / 25 配 false（STARTTLS）。
# 国内云厂商默认封禁 25 端口出方向，优先用 465 或 587。
AL_SMTP_PORT=465
AL_SMTP_USE_SSL=true
# [必改] 登录 SMTP 的账号，通常就是你的发信邮箱地址
AL_SMTP_USER=
# [必改] 多数服务商这里要填「授权码 / 应用专用密码」（在邮箱网页端单独申请），
#        **不是**网页登录密码。
AL_SMTP_PASSWORD=
# [必改] 发件人。地址部分要与 AL_SMTP_USER 一致，或属于已在服务商处验证的域名，
#        否则会被 SMTPSenderRefused 拒掉。留默认的 @localhost 必被拒。
AL_MAIL_FROM=AudienceLens <noreply@你的域名.com>
# [必改] 验证 / 重置链接的落点，即用户实际打开的站点地址。
#        配错这里邮件能发出，但用户点开链接是打不开的页面。
AL_PUBLIC_WEB_URL=https://你的域名.com
# 单次 SMTP 操作超时固定 15 秒（AL_SMTP_TIMEOUT_SECONDS，但 docker-compose.yml
# 没有透传这一项，所以在 Docker 部署下写在这里是不生效的——故意不列成配置项）。
#
# 暂时不想接邮件服务商？必须显式声明，否则拒绝启动：
#   AL_ALLOW_CONSOLE_MAIL=true
# 代价说清楚：邮箱验证与密码重置**完全不可用**；含令牌的完整邮件会写到
# 容器内 /app/data/outbox/（0600 文件），能读它的人即可接管任意账号。

# ---- HTTPS / Caddy 叠加层（用 docker-compose.prod.yml 时）----
# [必改] 申请证书用的正式域名（必须已解析到本机公网 IP，否则签发失败）。
# 漏填会回落成 localhost，向 Let's Encrypt 申请证书必然失败。
SITE_DOMAIN=你的域名.com

# 前端在**非** Caddy 场景下的宿主绑定。默认 80 = 裸跑（无 TLS）。
# 用 docker-compose.prod.yml 时这一项不用管：叠加层自己把前端钉在
# 127.0.0.1:8080，公网 80/443 留给 Caddy。
#
# 这里曾经是「[必改] FRONTEND_BIND=127.0.0.1:8080」，靠运维记得填。
# 漏填的后果不是报个错完事：frontend 先起来占住宿主 :80（caddy depends_on
# frontend），caddy 再想绑 :80 就失败退出——站点仍然能打开，只是**全程明文
# HTTP、没有任何 TLS**，而 docker compose up 的输出里只有一行不起眼的
# 容器启动失败。这是典型的「看起来部署成功了」。所以改成叠加层自己钉死。
FRONTEND_BIND=80

# 换掉 Caddy 用外部 nginx / 云负载均衡时，用它覆盖叠加层给前端定的绑定。
# 正常用 Caddy 的话不用动。
PROD_FRONTEND_BIND=127.0.0.1:8080

# ---- 危险默认值的逃生舱（正常不要打开）----
# 关闭认证时所有访客共用同一个 anonymous 身份，彼此看得见对方的评审。
# 类生产环境下 AL_AUTH_ENABLED=false 会被启动自检拦住，除非显式声明接受：
# AL_ALLOW_SHARED_ANONYMOUS=true

# ---- 可选调优（默认值一般够用）----
# 仅 AL_QUOTA_MODE=plan 时生效（credits 模式看的是 CDK 余额，与这两项无关）：
# AL_QUOTA_FREE_REVIEWS_PER_DAY=5
# AL_QUOTA_FREE_COST_USD_PER_DAY=1.0
# AL_RATELIMIT_PER_MINUTE=60
# AL_RATELIMIT_REVIEW_PER_HOUR=20
# AL_QUEUE_WORKERS=2
# AUDIENCELENS_MAX_CONCURRENCY=6
# AL_INTENT_MODEL=claude-haiku-4-5-20251001
# 换 Postgres 时用（默认 SQLite 单机够用）：
# AL_DATABASE_URL=postgresql://user:pass@host:5432/audiencelens
