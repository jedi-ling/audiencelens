{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "output-schema",
  "title": "Single Persona Review Output Schema",
  "description": "单个 Persona 评审输出的 JSON Schema",
  "type": "object",
  "required": [
    "persona_id",
    "persona_name",
    "persona_version",
    "task_type",
    "primary_stance",
    "confidence",
    "evidence_sufficiency",
    "evidence",
    "scores",
    "key_issues",
    "continue_triggers",
    "quit_triggers",
    "first_scan_observations",
    "must_comment_on_check",
    "missing_information",
    "voice_sample",
    "meta"
  ],
  "properties": {
    "persona_id": {
      "type": "string",
      "description": "Persona 标识"
    },
    "persona_name": {
      "type": "string",
      "description": "Persona 名称"
    },
    "persona_version": {
      "type": "string",
      "description": "Persona 版本"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "steam_page_review",
        "demo_first_play",
        "concept_review",
        "monetization_review",
        "looking_for_party_post",
        "update_announcement_review",
        "devlog_review",
        "kickstarter_review",
        "localization_review",
        "discord_community_review",
        "product_feedback_review",
        "pricing_page_review",
        "onboarding_review",
        "pitch_review"
      ],
      "description": "评审任务类型。此枚举必须与 src/runner/task_types.py 的 VALID_TASK_TYPES 完全一致——src/runner/persona_agent.py 在导入时断言两者相等，漂移会当场失败（此前少了 4 个，pitch_review 等合法输出被判枚举不符，报告拿不到评分）"
    },
    "primary_stance": {
      "type": "string",
      "minLength": 1,
      "description": "主要立场。schema 层不写死枚举（词表按 task_type 不同），由提示词按 task_type 注入约束；词表的唯一定义在 src/runner/persona_agent.py 的 TASK_STANCE_ENUM，与后端 services.TASK_TYPES[*].stance_enum 逐字对齐（聚合器拿它当立场聚类的 dict 键，自造说法会让共识/分歧统计失效）"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "对该立场的确信程度 0-1"
    },
    "evidence_sufficiency": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "基于现有证据做出判断的充分程度 0-1"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content", "inference_level"],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "证据内容"
          },
          "inference_level": {
            "type": "string",
            "enum": ["direct", "inferred", "gap"],
            "description": "推断层级：直接/推断/缺口"
          },
          "source_location": {
            "type": "string",
            "description": "来源位置（direct 时建议填写）"
          },
          "inference_basis": {
            "type": "string",
            "description": "推断依据（inferred 时建议填写）"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "证据列表"
    },
    "scores": {
      "type": "object",
      "required": ["base", "task_specific"],
      "properties": {
        "base": {
          "type": "object",
          "required": ["clarity", "trust"],
          "properties": {
            "clarity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "清晰度 1-5：看完材料能否一眼说清「这是什么、给谁、凭什么值得花时间或钱」。1=看完仍不知道它是什么，3=大意能懂但关键处要猜，5=信息组织清楚不必追问。全任务通用，报告靠它做跨人格横向对比，故为必填"
            },
            "trust": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "信任度 1-5：有多相信材料里的说法能兑现（团队/进度/数据/承诺）。1=通篇自说自话无可核验内容，3=部分有支撑部分是空头承诺，5=关键说法都能找到依据。全任务通用，必填"
            }
          },
          "additionalProperties": false
        },
        "task_specific": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "description": "任务专属维度评分，键为维度名，值为 1-5 整数。维度名由 task_type 决定，唯一定义在 src/runner/persona_agent.py 的 TASK_SCORE_DIMENSIONS（与后端 services.TASK_TYPES[*].score_dimensions 逐字对齐，由测试锁死）；提示词按 task_type 把该次要填的维度名注入骨架。此处不逐一枚举，避免再抄一份会漂移的清单——schema 只约束形状与取值范围，不强制维度齐全"
        }
      },
      "additionalProperties": false
    },
    "key_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "why_it_matters", "suggested_fix"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "严重程度"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "问题标题"
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1,
            "description": "为何重要"
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1,
            "description": "建议修复方式"
          }
        },
        "additionalProperties": false
      },
      "description": "关键问题列表"
    },
    "continue_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "继续触发条件"
    },
    "quit_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "放弃触发条件"
    },
    "first_scan_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "首次浏览观察"
    },
    "must_comment_on_check": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "必须评论项检查，键为评论项，值为是否已覆盖"
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "缺失信息列表"
    },
    "voice_sample": {
      "type": "string",
      "minLength": 1,
      "description": "1-2 句角色原声评价"
    },
    "meta": {
      "type": "object",
      "required": ["caveats", "is_synthetic"],
      "properties": {
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "注意事项，至少1条"
        },
        "is_synthetic": {
          "type": "boolean",
          "const": true,
          "description": "标记为合成输出（恒为 true）"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
