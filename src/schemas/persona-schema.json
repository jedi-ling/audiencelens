{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "persona-schema",
  "title": "Persona Configuration Schema",
  "description": "Persona YAML 的校验 Schema，定义虚拟评审角色的完整结构",
  "type": "object",
  "required": [
    "id",
    "name",
    "gender",
    "age_range",
    "region",
    "language",
    "archetype",
    "identity_summary",
    "gaming_profile",
    "behavior_profile",
    "motivations",
    "likes",
    "dislikes",
    "decision_rules",
    "quit_triggers",
    "continue_triggers",
    "first_scan_focus",
    "review_output"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P\\d{2}-[a-z0-9-]+$",
      "description": "Persona 唯一标识，格式 P00-slug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "角色名称"
    },
    "gender": {
      "type": "string",
      "enum": [
        "男",
        "女",
        "非二元",
        "未指定",
        "自我描述"
      ],
      "description": "性别"
    },
    "age_range": {
      "type": "string",
      "pattern": "^\\d{2,3}-\\d{2,3}$",
      "description": "年龄区间，如 25-35"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "description": "所在地区"
    },
    "language": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ],
      "description": "使用语言，字符串或字符串数组"
    },
    "archetype": {
      "type": "string",
      "minLength": 1,
      "description": "原型标签"
    },
    "methodology": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16,
      "description": "方法论流派标签：概括该人格怎么下判断（如「首屏承诺验证派」），比 archetype 更具体地指向判断方法；不含人口学信息"
    },
    "identity_summary": {
      "type": "string",
      "minLength": 1,
      "description": "身份概要"
    },
    "gaming_profile": {
      "type": "object",
      "required": [
        "experience",
        "platforms",
        "genres",
        "session_length"
      ],
      "properties": {
        "experience": {
          "type": "string",
          "enum": [
            "中核",
            "中核消费型",
            "商业视角",
            "平台口碑型",
            "平台重度浏览",
            "新手",
            "核心",
            "核心-老兵",
            "核心老兵",
            "老平台用户",
            "轻度",
            "轻度-中核",
            "轻度-教育型",
            "轻度-核心之间"
          ],
          "description": "游戏经验类型"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "常用平台列表"
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "偏好类型列表"
        },
        "session_length": {
          "type": "string",
          "minLength": 1,
          "description": "单次游戏时长"
        }
      },
      "additionalProperties": false
    },
    "behavior_profile": {
      "type": "object",
      "required": [
        "patience",
        "genre_literacy",
        "novelty_seeking",
        "risk_tolerance",
        "social_influence",
        "completion_drive",
        "price_sensitivity",
        "criticism_style",
        "emotional_engagement",
        "agency_preference",
        "tolerance_for_ambiguity",
        "platform_loyalty"
      ],
      "properties": {
        "patience": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很低",
            "很高",
            "高"
          ]
        },
        "genre_literacy": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很低",
            "很高",
            "高"
          ]
        },
        "novelty_seeking": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很低",
            "很高",
            "高"
          ]
        },
        "risk_tolerance": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很低",
            "高"
          ]
        },
        "social_influence": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很高",
            "高"
          ]
        },
        "completion_drive": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很低",
            "很高",
            "高"
          ]
        },
        "price_sensitivity": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很高",
            "高"
          ]
        },
        "criticism_style": {
          "type": "string",
          "enum": [
            "临场感分析",
            "亲子体验",
            "价值评估",
            "价值评估型",
            "传播视角",
            "体验结构式",
            "信息等价验证",
            "分析直给",
            "创新导向",
            "创造性批判",
            "功能清单式",
            "功能验证式",
            "协作导向",
            "口碑直觉",
            "可及性导向",
            "商业冷静",
            "困惑导向",
            "困惑点导向",
            "安全优先",
            "审美直觉",
            "对标式",
            "尖锐怀疑",
            "帧级精确",
            "快评式",
            "怀旧对标",
            "性价比直觉",
            "感受具体",
            "感受加例子",
            "感受导向",
            "教学评估",
            "文化立场评估",
            "本能反应式",
            "机制拆解",
            "条目化",
            "氛围导向",
            "温暖具体",
            "生活化直白",
            "知识评估",
            "短句直接",
            "社交体验评估",
            "社交空间评估",
            "竞技硬核",
            "细腻具体",
            "结构化分析",
            "舒适验证式",
            "观赛视角",
            "角色叙事评估",
            "运动效果评估",
            "通用设计"
          ]
        },
        "emotional_engagement": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很高",
            "高"
          ]
        },
        "agency_preference": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很高",
            "高"
          ]
        },
        "tolerance_for_ambiguity": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很低",
            "很高",
            "高"
          ]
        },
        "platform_loyalty": {
          "type": "string",
          "enum": [
            "中",
            "低",
            "很低",
            "高"
          ]
        }
      },
      "additionalProperties": false
    },
    "motivations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "动机列表"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "偏好列表"
    },
    "dislikes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "厌恶列表"
    },
    "decision_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "决策规则，至少1条"
    },
    "quit_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "放弃触发条件"
    },
    "continue_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "继续触发条件"
    },
    "first_scan_focus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "首次浏览关注点"
    },
    "review_output": {
      "type": "object",
      "required": [
        "tone",
        "strictness",
        "must_comment_on",
        "avoid"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "minLength": 1,
          "description": "评审语气"
        },
        "strictness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "严格程度 1-5"
        },
        "must_comment_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "必须评论的方面"
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "应避免的方面"
        }
      },
      "additionalProperties": false
    },
    "mbti": {
      "type": "string",
      "enum": [
        "INTJ",
        "INTP",
        "ENTJ",
        "ENTP",
        "INFJ",
        "INFP",
        "ENFJ",
        "ENFP",
        "ISTJ",
        "ISFJ",
        "ESTJ",
        "ESFJ",
        "ISTP",
        "ISFP",
        "ESTP",
        "ESFP",
        "未指定"
      ],
      "description": "MBTI 类型（可选）"
    },
    "communication_style": {
      "type": "string",
      "enum": [
        "严谨务实型",
        "共情理想型",
        "务实操作型",
        "务实管理型",
        "发散联想型",
        "忠诚守护型",
        "感受审美型",
        "战略指挥型",
        "敏感体验型",
        "温暖表达型",
        "灵活应变型",
        "热情服务型",
        "生活化直白",
        "生活化直白→温暖表达型",
        "直接行动型",
        "社交活力型",
        "简洁分析型",
        "自由表达型"
      ],
      "description": "沟通风格（可选）"
    },
    "task_affinity": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "任务亲和度映射，键为任务类型，值为 0-1 浮点数（可选）"
    },
    "evidence_types_needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "所需证据类型列表（可选）"
    },
    "model_hint": {
      "type": "string",
      "enum": [
        "haiku",
        "sonnet",
        "opus"
      ],
      "description": "推荐模型（可选）"
    },
    "source_basis": {
      "type": "string",
      "description": "来源依据（可选）"
    },
    "weight_default": {
      "type": "number",
      "default": 1.0,
      "description": "默认权重（可选）"
    },
    "version": {
      "type": "string",
      "description": "Persona 版本号（可选）"
    },
    "last_calibrated_at": {
      "type": "string",
      "description": "最后校准时间（可选）"
    },
    "notes": {
      "type": "string",
      "description": "备注（可选）"
    },
    "ethics_compliance": {
      "type": "object",
      "required": [
        "behavior_over_demographics",
        "stereotype_risk",
        "gap_filling_violations",
        "mbti_usage"
      ],
      "properties": {
        "behavior_over_demographics": {
          "type": "boolean",
          "const": true,
          "description": "核心原则：行为优先于人口统计，必须为 true"
        },
        "stereotype_risk": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "description": "刻板印象风险等级，基于刻板印象回避清单检查结果"
        },
        "gap_filling_violations": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "空缺填补违规计数，0 表示无违规"
        },
        "mbti_usage": {
          "type": "string",
          "enum": [
            "style_only",
            "logic",
            "none"
          ],
          "description": "MBTI 使用方式：style_only=仅修饰表达风格（合规），logic=用于推导判断（违规），none=未使用MBTI"
        }
      },
      "additionalProperties": false,
      "description": "伦理合规信息，对应 ethics.md 守则"
    },
    "validation": {
      "type": "object",
      "properties": {
        "must_comment_on_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "必须评论项的覆盖百分比（0-100%）"
        },
        "evidence_direct_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "直接证据占比（0-100%），direct inference_level 的证据条数 / 总证据条数"
        },
        "jaccard_distance_from_others": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "与其他 persona 的 Jaccard 距离（0-1），值越大差异化越高"
        }
      },
      "additionalProperties": false,
      "description": "验证指标，用于量化 persona 输出质量"
    }
  },
  "additionalProperties": false
}
